{
  "manifest_version": 3,
  "name": "Kairos for Canvas",
  "version": "1.0.0",
  "description": "Keeps an eye on Canvas for you: what changed, what's next, and what it costs to skip. Reads Canvas only; never submits or posts.",
  "minimum_chrome_version": "116",
  "permissions": [
    "alarms",
    "storage",
    "nativeMessaging",
    "sidePanel"
  ],
  "host_permissions": [
    "https://canvas.colorado.edu/*",
    "https://*.instructure.com/*"
  ],
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://canvas.colorado.edu/*",
        "https://*.instructure.com/*"
      ],
      "js": [
        "ui/dashboard.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "panel.html"
  },
  "icons": {
    "16": "icons/kairos-16.png",
    "32": "icons/kairos-32.png",
    "48": "icons/kairos-48.png",
    "128": "icons/kairos-128.png"
  },
  "action": {
    "default_title": "Kairos: open the side panel",
    "default_icon": {
      "16": "icons/kairos-16.png",
      "32": "icons/kairos-32.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "ui/dashboard.css",
        "lib/format.js",
        "fonts/*.woff2",
        "brand/*.svg"
      ],
      "matches": [
        "https://canvas.colorado.edu/*",
        "https://*.instructure.com/*"
      ]
    }
  ],
  "key": ""
}
