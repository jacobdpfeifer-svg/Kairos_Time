{
  "productName": "Kairos",
  "version": "0.1.0",
  "identifier": "com.kairosstudy.student",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kairos",
        "width": 1080,
        "height": 740,
        "minWidth": 720,
        "minHeight": 520,
        "center": true,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "shadow": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'none'"
    },
    "trayIcon": {
      "iconPath": "icons/trayTemplate.png",
      "iconAsTemplate": true
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../src": "core/src",
      "../../templates": "core/templates",
      "../../schools": "core/schools",
      "../../skills": "core/skills",
      "../../browser/package.json": "core/browser/package.json",
      "../../browser/scripts": "core/browser/scripts",
      "../../plugins": "core/plugins",
      "runtime/browser-node_modules": "core/browser/node_modules",
      "runtime/python": "runtime/python",
      "runtime/node": "runtime/node"
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "Developer ID Application: Jacob Pfeifer (BHFNTM69P2)"
    }
  },
  "plugins": {}
}
