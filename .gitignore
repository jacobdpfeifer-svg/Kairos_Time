*.py[cod]
*$py.class

# Tool caches
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Distribution / packaging
dist/
build/
*.egg-info/

# Environment variables
.env
.env.*
!.env.template
.env.bak-*
.env.bak

# OAuth / credential dumps (never commit)
client_secret.json
credentials.json
token.json
**/client_secret.json
**/credentials.json
**/token.json
secrets/
*.pem

