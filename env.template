# Kairos — local-first student Canvas MCP
# Copy to .env. Never commit .env.

CANVAS_API_TOKEN=your_canvas_api_token_here
CANVAS_API_URL=https://canvas.colorado.edu/api/v1
SCHOOL_SLUG=cu-boulder
# DEV_USER_ROOT=/absolute/path/to/user-root

MCP_SERVER_NAME=kairos-canvas-mcp
DEBUG=false
API_TIMEOUT=30
CACHE_TTL=300
MAX_CONCURRENT_REQUESTS=10
LOG_LEVEL=INFO
LOG_API_REQUESTS=false

# Opt-in for multi-user / shared-host FERPA; self-only local default is off
ENABLE_DATA_ANONYMIZATION=false
ANONYMIZATION_DEBUG=false
LOG_REDACT_PII=true

CANVAS_ROLE=student

# Preview-only tools (never POST) plus self-only mark_module_item_done
STUDENT_WRITE_TOOLS=submit_assignment,comment_on_my_submission,mark_module_item_done

# INERT: nothing reads these. The per-course syllabus write policy they named
# belongs to the upstream educator-era write path, which is gone; Canvas writes
# are preview-only with no execute branch. Kept as a record of what a future
# write path would have to re-establish. See config/overlays/README.md.
COURSE_AGENT_POLICY_ENABLED=true
COURSE_AGENT_POLICY_DEFAULT=deny

INSTITUTION_NAME=University of Colorado Boulder
TIMEZONE=America/Denver

# Optional Google OAuth for GCal/Gmail actuators (uv pip install -e '.[google]')
# GOOGLE_OAUTH_CLIENT_SECRETS=/absolute/path/to/client_secret.json
# KAIROS_LIVE_SKILL_EVAL=0
# PRODUCT_USER_ID=dev
# AUDIT_LOG_DIR=
# SCHOOLS_DIR=

# Hosted model swap (config only — do not hardcode vendor calls). Cloud key optional.
KAIROS_LLM_PROVIDER=gemini
KAIROS_LLM_API_KEY=
KAIROS_LLM_MODEL=gemini-3.5-flash-lite
KAIROS_LLM_EMBED_MODEL=gemini-embedding-001
KAIROS_LLM_WRITE_PROVIDER=anthropic
KAIROS_LLM_WRITE_API_KEY=
KAIROS_LLM_WRITE_MODEL=claude-haiku-4-5

# Voice intake (cd browser && npm run voice). Gemini Live API key from https://aistudio.google.com/apikey
# Use a paid-tier key: audio of your goals goes to Google. See docs/VOICE.md.
# GEMINI_API_KEY=
# GEMINI_LIVE_MODEL=        # list what your key can use: cd browser && npm run voice-models
# VOICE_NAME=               # optional prebuilt voice, e.g. Kore
# VOICE_PORT=8787
# VOICE_SILENCE_MS=1500     # silence that ends your turn; raise if it cuts you off mid-thought
