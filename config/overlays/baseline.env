# Baseline overlay: defaults for contributors/early adopters.
# Merge with env.template to build `.env`.

# Bind settings are reserved for future HTTP transport (ignored in stdio mode).
MCP_BIND_HOST=127.0.0.1
MCP_BIND_PORT=8000

# Code execution sandbox defaults (best-effort; CPU limit in seconds).
# INERT: nothing reads these. The caller-supplied-TypeScript execution tool
# they guarded is gone from this tree; see config/overlays/README.md.
ENABLE_TS_SANDBOX=true
TS_SANDBOX_MODE=auto
TS_SANDBOX_BLOCK_OUTBOUND_NETWORK=true
TS_SANDBOX_CPU_LIMIT=20
TS_SANDBOX_MEMORY_LIMIT_MB=256
TS_SANDBOX_TIMEOUT_SEC=20

# Hosted model swap. Keys stay blank until the student adds one (cloud key optional).
KAIROS_LLM_PROVIDER=gemini
KAIROS_LLM_API_KEY=
KAIROS_LLM_MODEL=gemini-3.5-flash-lite
KAIROS_LLM_EMBED_MODEL=gemini-embedding-001
KAIROS_LLM_WRITE_PROVIDER=anthropic
KAIROS_LLM_WRITE_API_KEY=
KAIROS_LLM_WRITE_MODEL=claude-haiku-4-5

# Privacy/logging (some flags are placeholders)
LOG_LEVEL=INFO
LOG_API_REQUESTS=false
LOG_REDACT_PII=true
LOG_ROTATION_DAYS=30

# INERT: nothing reads these (see config/overlays/README.md). Canvas writes are
# preview-only with no execute branch, so there is no policy for them to gate.
COURSE_AGENT_POLICY_ENABLED=true
COURSE_AGENT_POLICY_DEFAULT=deny
# Self-only student default (public/enterprise overlays opt in)
ENABLE_DATA_ANONYMIZATION=false
